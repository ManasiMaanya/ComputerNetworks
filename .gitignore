# Raw datasets (Topology Zoo, SNDlib, CAIDA) stay local.
projects/xai-dynamic-routing/data/raw/*
!projects/xai-dynamic-routing/data/raw/.gitkeep

# Generated training tables.
projects/xai-dynamic-routing/data/processed/*
!projects/xai-dynamic-routing/data/processed/.gitkeep

# Trained model weights (~15 MB) and reports: regenerate with scripts/train.py.
projects/xai-dynamic-routing/models/*
!projects/xai-dynamic-routing/models/.gitkeep

# Generated outputs: regenerate with scripts/demo.py.
projects/xai-dynamic-routing/outputs/routes/*
!projects/xai-dynamic-routing/outputs/routes/.gitkeep

projects/xai-dynamic-routing/outputs/explanations/*
!projects/xai-dynamic-routing/outputs/explanations/.gitkeep

